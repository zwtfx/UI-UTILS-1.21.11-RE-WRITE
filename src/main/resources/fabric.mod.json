{
    "schemaVersion": 1,
    "id": "packetcontrol",
    "version": "${version}",
    "name": "Packet Control",
    "description": "A client-side utility for controlling packet sending and GUI interactions.",
    "authors": [
        "AI Assistant"
    ],
    "contact": {
        "homepage": "https://fabricmc.net/",
        "sources": "https://github.com/FabricMC/fabric-example-mod"
    },
    "license": "CC0-1.0",
    "icon": "assets/packetcontrol/icon.png",
    "environment": "client",
    "entrypoints": {
        "client": [
            "com.example.packetcontrol.PacketControl::onInitializeClient"
        ],
        "main": [
            "com.example.packetcontrol.PacketControl"
        ]
    },
    "mixins": [
        "packetcontrol.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.16.2",
        "fabric-api": "*",
        "minecraft": "~1.21.1",
        "java": ">=21"
    },
    "suggests": {
        "cloth-config": ">=15.0.0"
    }
}
